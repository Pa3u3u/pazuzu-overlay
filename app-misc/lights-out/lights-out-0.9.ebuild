RUST_MIN_VER="1.82"

inherit cargo systemd

DESCRIPTION="Turn off RGB lights when mpv is fullscreen"
HOMEPAGE="https://github.com/Pa3u3u/lights-out"
SRC_URI="
	https://github.com/Pa3u3u/lights-out/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="MIT"
# Dependent crate licenses
LICENSE+=" Apache-2.0 GPL-2 MIT Unicode-3.0"
SLOT="0"
KEYWORDS="~amd64"

IUSE="systemd"

PATCHES=(
	"${FILESDIR}/lights-out-service.patch"
)

src_install() {
	dobin "target/release/lights-out"

	if use systemd; then
		systemd_douserunit "lights-out.service"
		elog "Systemd user service is installed in $(systemd_get_userunitdir)."
	fi
}
